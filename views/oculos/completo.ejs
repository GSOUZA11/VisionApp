<script>

const precoMin = document.getElementById('preco-min');
const precoMax = document.getElementById('preco-max');
const precoAtual = document.getElementById('preco-atual');
const produtos = document.querySelectorAll('.card-produto');

function extrairPreco(texto) {

    return parseFloat(
        texto
            .replace('R$', '')
            .replace('.', '')
            .replace(',', '.')
            .trim()
    );

}

function filtrarProdutos() {

    const min = Number(precoMin.value);
    const max = Number(precoMax.value);

    produtos.forEach(produto => {

        const preco =
            extrairPreco(
                produto.querySelector('.preco-produto').innerText
            );

        produto.parentElement.style.display =
            preco >= min && preco <= max
                ? 'block'
                : 'none';

    });

    precoAtual.textContent = `${min} - ${max}`;

}

precoMin.addEventListener('input', filtrarProdutos);
precoMax.addEventListener('input', filtrarProdutos);

</script>