        </p>
    </div>

    <!-- Resumo da conta -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">


                        <div>
                            <p class="text-muted mb-1">
                                Meus pedidos
                            </p>

                            <h2 class="h3 fw-bold mb-0">
                                <%= resumo?.quantidadePedidos ?? 0 %>
                            </h2>

                            <small class="text-muted">
                                Pedidos registrados na sua conta
                            </small>
                        </div>
                    </div>

                    <a href="/pedido" class="btn btn-dark mt-3">
                        Consultar pedidos

                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <tr>
                        <tr>
                            <div>
                                <p class="text-muted mb-1">
                                    Valor total dos pedidos
                                </p>

                                <h2 class="h3 fw-bold mb-0">
                                    <%= Number(resumo?.valorTotal ?? 0).toLocaleString('pt-BR', { style: 'currency' ,
                                        currency: 'BRL' }) %>
                                </h2>

                                <small class="text-muted">
                                    Soma dos valores registrados
                                </small>
                            </div>
                    </div>

                    <a href="/pedido" class="btn btn-dark mt-3">
                        Ver detalhes

                    </a>
                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Dados pessoais -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div>
                            <h2 class="h5 fw-bold mb-1">
                                Seus dados
                            </h2>

                            <p class="text-muted small mb-0">
                                Informações da sua conta
                            </p>
                        </div>
                    </div>

                    <hr>

                    <div class="mb-4">
                        <label class="form-label text-muted small mb-1">
                            Nome completo
                        </label>

                        <p class="fw-semibold mb-0">
                            <%= usuario.nome || 'Não informado' %>
                        </p>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small mb-1">
                            Telefone
                        </label>

                        <p class="fw-semibold mb-0">
                            <%= usuario.telefone || 'Não informado' %>
                        </p>
                    </div>

                    <button type="button" class="btn btn-dark" data-bs-toggle="modal"
                        data-bs-target="#modalEditarDados">
                        Editar meus dados
                    </button>

                </div>
            </div>
        </div>

        <!-- Atalhos -->
        <div class="col-12 col-lg-7">

            <h2 class="h5 fw-bold mb-3">Acesso rápido</h2>

            <div class="row g-3">

                <!-- Pedidos -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <h3 class="h6 fw-bold">
                                        Meus pedidos
                                    </h3>

                                    <p class="text-muted mb-3">
                                        Consulte suas compras e os detalhes
                                        dos pedidos registrados.
                                    </p>

                                    <a href="/pedido" class="btn btn-dark">
                                        Ver meus pedidos
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Catálogo -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                              

                                <div class="flex-grow-1">
                                    <h3 class="h6 fw-bold">
                                        Nossa coleção
                                    </h3>

                                    <p class="text-muted mb-3">
                                        Explore os modelos de óculos
                                        disponíveis no catálogo.
                                    </p>

