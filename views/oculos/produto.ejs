
<%
const preco = Number(oculos?.preco || 0);
const estoque = oculos?.estoque;
const disponivel = estoque == null || Number(estoque) > 0;

const imagem = oculos?.imagem
    ? (/^https?:\/\//i.test(String(oculos.imagem)) ||
       String(oculos.imagem).startsWith('/')
        ? oculos.imagem
        : '/uploads/' + oculos.imagem)
    : null;

const categoria = oculos?.categoria || oculos?.tipo || 'Coleção Vision';

const moeda = (valor) =>
    Number(valor || 0).toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
    });

const listaRecomendacoes = typeof recomendacoes !== 'undefined' && Array.isArray(recomendacoes)
    ? recomendacoes.filter(item => String(item.id) !== String(oculos?.id)).slice(0, 3)
    : [];
%>

<style>
.vision-produto {
    --vp-blue: #4964e8;
    --vp-blue-dark: #304bc6;
    --vp-ink: #20283a;
    --vp-muted: #7a8495;
    --vp-line: #e8ebf2;
    max-width: 1440px;
    margin: auto;
    padding: 28px 30px 70px;
    color: var(--vp-ink);
}
.vision-produto *,
.vision-produto *::before,
.vision-produto *::after { box-sizing: border-box; }

.vp-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 25px;
    color: var(--vp-muted);
    font-size: 13px;
}
.vp-breadcrumb a { color: #596984; text-decoration: none; }
.vp-breadcrumb a:hover { color: var(--vp-blue); }

.vp-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, .9fr) minmax(250px, .68fr);
    align-items: start;
    gap: 26px;
}
.vp-gallery {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 13px;
    min-width: 0;
}
.vp-thumbnails { display: flex; flex-direction: column; gap: 10px; }
.vp-thumbnail {
    width: 58px;
    height: 62px;
    display: grid;
    place-items: center;
    padding: 5px;
    overflow: hidden;
    border: 1px solid #dfe4ed;
    border-radius: 8px;
    background: white;
}
.vp-thumbnail img { width: 100%; height: 100%; object-fit: contain; }
.vp-thumbnail.active { border: 2px solid var(--vp-blue); }

.vp-main-photo {
    position: relative;
    height: 470px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
    border-radius: 13px;
    background: #f5f6f8;
}
.vp-main-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform .3s ease;
}
.vp-main-photo:hover img { transform: scale(1.035); }
.vp-image-fallback { color: var(--vp-muted); text-align: center; }
.vp-image-fallback i { display: block; margin-bottom: 12px; font-size: 48px; }

.vp-info { min-width: 0; padding-top: 4px; }
.vp-brand {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 15px;
    color: var(--vp-blue);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.6px;
}
.vp-brand-mark {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #edf1ff;
    font-size: 15px;
}
.vp-product-title {
    margin: 0 0 13px;
    font-size: clamp(25px, 2.2vw, 35px);
    font-weight: 750;
    line-height: 1.22;
    overflow-wrap: anywhere;
}
.vp-category {
    display: inline-block;
    margin-bottom: 15px;
    padding: 7px 11px;
    border-radius: 6px;
    background: #edf1ff;
    color: #3d57cc;
    font-size: 12px;
    font-weight: 700;
}
.vp-description {
    margin: 0;
    color: #68758a;
    font-size: 14px;
    line-height: 1.8;
    white-space: pre-line;
    overflow-wrap: anywhere;
}
.vp-rule, .vp-buy-rule {
    height: 1px;
    border: 0;
    background: var(--vp-line);
}
.vp-rule { margin: 22px 0; }
.vp-price-label { margin: 0 0 5px; color: var(--vp-muted); font-size: 13px; }
.vp-price { margin: 0; font-size: clamp(30px, 2.4vw, 37px); font-weight: 850; }
.vp-price-caption { margin: 8px 0 0; color: #778296; font-size: 12px; }

.vp-specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 25px;
}
.vp-spec { min-width: 0; padding: 13px; border: 1px solid var(--vp-line); border-radius: 9px; }
.vp-spec span { display: block; margin-bottom: 6px; color: var(--vp-muted); font-size: 11px; }
.vp-spec strong { display: block; font-size: 13px; overflow-wrap: anywhere; }

.vp-buy-panel {
    min-width: 0;
    padding: 19px;
    border: 1px solid #e0e5ee;
    border-radius: 12px;
    background: white;
    box-shadow: 0 5px 20px rgb(35 48 75 / 4%);
}
.vp-delivery {
    padding: 14px;
    margin-bottom: 20px;
    border-radius: 8px;
    background: #f0f5ff;
}
.vp-delivery-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    color: #315dcc;
    font-size: 13px;
    font-weight: 750;
}
.vp-delivery p { margin: 0; color: #687790; font-size: 12px; line-height: 1.65; }
.vp-stock {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 20px;
    color: #16834e;
    font-size: 13px;
    font-weight: 750;
}
.vp-stock.out { color: #c62828; }
.vp-quantity-label { display: block; margin-bottom: 9px; font-size: 13px; font-weight: 700; }
.vp-quantity {
    width: 100%;
    height: 45px;
    padding: 10px 12px;
    border: 1px solid #d9dfeb;
    border-radius: 7px;
    outline: none;
    background: white;
}
.vp-quantity:focus { border-color: var(--vp-blue); box-shadow: 0 0 0 3px rgb(73 100 232 / 12%); }
.vp-action {
    width: 100%;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 12px;
    padding: 12px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 750;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition: background .2s ease, transform .2s ease;
}
.vp-action:hover { transform: translateY(-1px); }
.vp-action:disabled { opacity: .65; cursor: not-allowed; transform: none; }
.vp-action-primary { background: var(--vp-blue); color: white; }
.vp-action-primary:hover { background: var(--vp-blue-dark); color: white; }
.vp-action-secondary { border-color: #dce5ff; background: #eaf0ff; color: #3559ce; }
.vp-action-secondary:hover { background: #dce6ff; color: #2648b7; }
.vp-buy-rule { margin: 19px 0; }
.vp-trust { display: flex; align-items: flex-start; gap: 10px; color: #6b778b; font-size: 12px; line-height: 1.7; }
.vp-trust + .vp-trust { margin-top: 15px; }
.vp-trust i { color: #36835b; font-size: 18px; }
.vp-trust strong { color: #354155; }

.vp-toast {
    position: fixed;
    z-index: 9999;
    right: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    width: min(390px, calc(100vw - 32px));
    padding: 16px 18px;
    border: 1px solid #d8eee0;
    border-radius: 12px;
    background: white;
    box-shadow: 0 12px 35px rgb(25 40 65 / 16%);
    opacity: 0;
    pointer-events: none;
    transform: translateY(15px);
    transition: opacity .25s ease, transform .25s ease;
}
.vp-toast.visible { opacity: 1; transform: translateY(0); }
.vp-toast-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #e6f7ed;
    color: #16834e;
    font-size: 20px;
}
.vp-toast.error .vp-toast-icon { background: #ffebeb; color: #c62828; }
.vp-toast strong { display: block; margin-bottom: 3px; font-size: 14px; }
.vp-toast p { margin: 0; color: var(--vp-muted); font-size: 12px; }

.vp-recommendations { margin-top: 55px; padding-top: 32px; border-top: 1px solid var(--vp-line); }
.vp-recommendation-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 22px;
}
.vp-eyebrow { margin-bottom: 7px; color: var(--vp-blue); font-size: 11px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
.vp-recommendation-heading h2 { margin: 0; font-size: clamp(23px, 2vw, 30px); font-weight: 750; }
.vp-recommendation-heading p { margin: 8px 0 0; color: var(--vp-muted); font-size: 13px; }
.vp-all-products { display: inline-flex; align-items: center; gap: 7px; color: var(--vp-blue); font-size: 13px; font-weight: 700; text-decoration: none; }
.vp-all-products:hover { color: var(--vp-blue-dark); }

.vp-product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.vp-suggestion {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e5e9f0;
    border-radius: 12px;
    background: white;
    transition: transform .25s ease, box-shadow .25s ease;
}
.vp-suggestion:hover { transform: translateY(-5px); box-shadow: 0 12px 28px rgb(29 43 67 / 9%); }
.vp-suggestion-card-link { display: block; height: 100%; color: inherit; text-decoration: none; }
.vp-suggestion-card-link:hover { color: inherit; }
.vp-suggestion-image {
    position: relative;
    height: 205px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 13px;
    overflow: hidden;
    background: #f5f6f8;
}
.vp-suggestion-image img { width: 100%; height: 100%; object-fit: contain; mix-blend-mode: multiply; transition: transform .3s ease; }
.vp-suggestion:hover .vp-suggestion-image img { transform: scale(1.06); }
.vp-suggestion-body { padding: 15px; }
.vp-suggestion-category { margin-bottom: 7px; color: #7a8496; font-size: 11px; }
.vp-suggestion-name { min-height: 40px; margin: 0 0 8px; color: #273247; font-size: 14px; font-weight: 750; line-height: 1.45; overflow-wrap: anywhere; }
.vp-suggestion-description { min-height: 36px; margin: 0 0 14px; color: #778195; font-size: 11px; line-height: 1.6; }
.vp-suggestion-bottom { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.vp-suggestion-price { color: #20283a; font-size: 17px; font-weight: 850; white-space: nowrap; }
.vp-suggestion-link { width: 34px; height: 34px; flex-shrink: 0; display: grid; place-items: center; border-radius: 8px; background: #edf1ff; color: var(--vp-blue); }
.vp-empty { padding: 45px 20px; border: 1px solid var(--vp-line); border-radius: 12px; text-align: center; }
.vp-empty i { color: #8994a6; font-size: 45px; }
.vp-empty h1 { margin: 15px 0 8px; font-size: 26px; }
.vp-empty p { color: var(--vp-muted); }

@media (max-width: 1150px) {
    .vp-layout { grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: 24px; }
    .vp-buy-panel { grid-column: 1 / -1; }
}
@media (max-width: 720px) {
    .vision-produto { padding: 20px 15px 45px; }
    .vp-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .vp-gallery, .vp-info, .vp-buy-panel { grid-column: 1; }
    .vp-gallery { grid-template-columns: 47px minmax(0, 1fr); gap: 10px; }
    .vp-thumbnail { width: 47px; height: 52px; }
    .vp-main-photo { height: min(85vw, 390px); min-height: 250px; padding: 15px; }
    .vp-product-title { font-size: 28px; }
    .vp-buy-panel { padding: 17px; }
    .vp-recommendations { margin-top: 38px; padding-top: 26px; }
    .vp-product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .vp-suggestion-image { height: 155px; }
    .vp-suggestion-body { padding: 12px; }
    .vp-suggestion-price { font-size: 15px; }
}
@media (max-width: 360px) {
    .vp-gallery { grid-template-columns: 40px minmax(0, 1fr); }
    .vp-thumbnail { width: 40px; height: 45px; }
    .vp-suggestion-image { height: 130px; }
}
</style>

<main class="vision-produto">
    <% if (oculos) { %>
        <nav class="vp-breadcrumb" aria-label="Navegação">
        </nav>

        <div class="vp-layout">
            <section class="vp-gallery">
                <div class="vp-thumbnails">
                    <div class="vp-thumbnail active">
                        <% if (imagem) { %>
                            <img src="<%= imagem %>" alt="Miniatura de <%= oculos.nome %>"
                                 onerror="this.style.display='none'">
                        <% } else { %>
                            <i class="bi bi-eyeglasses fs-4"></i>
                        <% } %>
                    </div>
                </div>

                <div class="vp-main-photo">
                    <% if (imagem) { %>
                        <img id="vpImagemPrincipal" src="<%= imagem %>" alt="<%= oculos.nome %>"
                             onerror="this.onerror=null;this.style.display='none';document.getElementById('vpImagemFallback').hidden=false">
                        <div id="vpImagemFallback" class="vp-image-fallback" hidden>
                            <i class="bi bi-image"></i>
                            Imagem não disponível
                        </div>
                    <% } else { %>
                        <div class="vp-image-fallback">
                            <i class="bi bi-eyeglasses"></i>
                            Imagem não disponível
                        </div>
                    <% } %>
                </div>
            </section>

            <section class="vp-info">
                <div class="vp-brand">
                    <span class="vp-brand-mark"><i class="bi bi-eyeglasses"></i></span>
                    VISION COLLECTION
                </div>

                <h1 class="vp-product-title"><%= oculos.nome %></h1>

                <span class="vp-category">
                    <i class="bi bi-tag me-1"></i>
                    <%= categoria %>
                </span>

                <p class="vp-description"><%= oculos.descricao || 'Descubra seu próximo estilo com a coleção Vision. Confira os detalhes deste modelo e encontre o óculos ideal para você.' %></p>

                <hr class="vp-rule">

                <p class="vp-price-label">Preço do produto</p>
                <p class="vp-price"><%= moeda(preco) %></p>
                <p class="vp-price-caption">
                    <i class="bi bi-shield-check me-1"></i>
                    Compra realizada pela loja Vision
                </p>

                <div class="vp-specs">
                    <div class="vp-spec">
                        <span>Categoria</span>
                        <strong><%= categoria %></strong>
                    </div>
                    <div class="vp-spec">
                        <span>Cor</span>
                        <strong><%= oculos.cor || 'Não informada' %></strong>
                    </div>
                    <div class="vp-spec">
                        <span>Tamanho</span>
                        <strong><%= oculos.tamanho || 'Não informado' %></strong>
                    </div>
                    <div class="vp-spec">
                        <span>Disponibilidade</span>
                        <strong>
                            <% if (estoque == null) { %>
                                Consulte a loja
                            <% } else if (Number(estoque) > 0) { %>
                                Em estoque
                            <% } else { %>
                                Esgotado
                            <% } %>
                        </strong>
                    </div>
                </div>
            </section>

            <aside class="vp-buy-panel">
                <div class="vp-delivery">
                    <div class="vp-delivery-title">
                        <i class="bi bi-truck fs-5"></i>
                        Informações de entrega
                    </div>
                    <p>Consulte as opções de entrega disponíveis durante a finalização da compra.</p>
                </div>

                <p class="vp-stock <%= disponivel ? '' : 'out' %>">
                    <i class="bi <%= disponivel ? 'bi-check-circle-fill' : 'bi-x-circle-fill' %>"></i>
                    <%= estoque == null ? 'Disponibilidade a confirmar' : Number(estoque) > 0 ? 'Produto disponível' : 'Produto esgotado' %>
                </p>

                <% if (disponivel) { %>
                    <form id="vpFormularioCompra" action="/carrinho/adicionar/<%= oculos.id %>" method="POST">
                        <label class="vp-quantity-label" for="vpQuantidade">Quantidade</label>
                        <input
                            class="vp-quantity"
                            type="number"
                            id="vpQuantidade"
                            name="quantidade"
                            value="1"
                            min="1"
                            max="<%= estoque == null ? 99 : Number(estoque) %>"
                            required
                        >

                        <button id="vpAdicionarCarrinho" type="submit" class="vp-action vp-action-primary">
                            <i class="bi bi-cart-plus"></i>
                            Adicionar ao carrinho
                        </button>
                    </form>

                    <button id="vpComprarAgora" type="button" class="vp-action vp-action-secondary">
                        <i class="bi bi-lightning-fill"></i>
                        Comprar agora
                    </button>
                <% } else { %>
                    <button type="button" class="vp-action vp-action-primary" disabled>
                        <i class="bi bi-x-circle"></i>
                        Produto esgotado
                    </button>
                <% } %>

                <hr class="vp-buy-rule">

                <div class="vp-trust">
                    <i class="bi bi-shield-check"></i>
                    <div><strong>Compre com tranquilidade</strong><br>Confira os detalhes do pedido antes de concluir a compra.</div>
                </div>
                <div class="vp-trust">
                    <i class="bi bi-bag-check"></i>
                    <div>Acompanhe seus pedidos pela sua área de cliente após a compra.</div>
                </div>
                <div class="vp-trust">
                    <i class="bi bi-headset"></i>
                    <div>Precisa de ajuda? Consulte os canais de atendimento da Vision.</div>
                </div>
            </aside>
        </div>
    <% } else { %>
        <div class="vp-empty">
            <i class="bi bi-search"></i>
            <h1>Produto não encontrado</h1>
            <p>Este óculos não está disponível no catálogo no momento.</p>
            <a href="/oculos/completo" class="vp-action vp-action-primary" style="max-width:280px;margin:20px auto 0">
                <i class="bi bi-arrow-left"></i>
                Voltar para os óculos
            </a>
        </div>
    <% } %>

    <section class="vp-recommendations">
        <div class="vp-recommendation-heading">
            <div>
                <div class="vp-eyebrow">Encontre seu estilo</div>
                <h2>Explore mais modelos</h2>
                <p>Confira outros óculos disponíveis na coleção Vision.</p>
            </div>
            <a href="/oculos" class="vp-all-products">
                Ver produtos da loja <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <% if (listaRecomendacoes.length > 0) { %>
            <div class="vp-product-grid" id="vpGradeSugestoes">
                <% listaRecomendacoes.forEach((produto, indice) => { %>
                    <article class="vp-suggestion" style="animation-delay:<%= indice * 35 %>ms">
                        <a class="vp-suggestion-card-link" href="/oculos/produto/<%= produto.id %>">
                            <div class="vp-suggestion-image">
                                <% if (produto.imagem) { %>
                                    <img
                                        src="<%= /^https?:\/\//i.test(String(produto.imagem)) || String(produto.imagem).startsWith('/') ? produto.imagem : '/uploads/' + produto.imagem %>"
                                        alt="<%= produto.nome %>"
                                        loading="lazy"
                                        onerror="this.onerror=null;this.src='https://placehold.co/600x400/f4f5f8/7a8495?text=Vision+Eyewear'"
                                    >
                                <% } else { %>
                                    <div class="vp-image-fallback">
                                        <i class="bi bi-eyeglasses"></i>
                                        Imagem não disponível
                                    </div>
                                <% } %>
                            </div>

                            <div class="vp-suggestion-body">
                                <div class="vp-suggestion-category">
                                    <%= produto.categoria || produto.tipo || 'Óculos Vision' %>
                                </div>
                                <h3 class="vp-suggestion-name"><%= produto.nome %></h3>
                                <p class="vp-suggestion-description">
                                    <%= produto.descricao || 'Conheça este modelo da coleção Vision.' %>
                                </p>
                                <div class="vp-suggestion-bottom">
                                    <span class="vp-suggestion-price"><%= moeda(produto.preco) %></span>
                                    <span class="vp-suggestion-link" aria-label="Ver este produto">
                                        <i class="bi bi-arrow-up-right"></i>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="vp-empty">
                <i class="bi bi-eyeglasses"></i>
                <h1>Nenhum outro modelo disponível</h1>
                <p>Cadastre outros óculos para exibi-los nesta seção.</p>
                <a href="/oculos/completo" class="vp-action vp-action-primary" style="max-width:280px;margin:20px auto 0">
                    Ver catálogo completo
                </a>
            </div>
        <% } %>
    </section>
</main>

<div id="vpToast" class="vp-toast" role="status" aria-live="polite">
    <div class="vp-toast-icon"><i id="vpToastIcon" class="bi bi-check-lg"></i></div>
    <div>
        <strong id="vpToastTitulo">Produto adicionado!</strong>
        <p id="vpToastTexto">O produto foi adicionado ao carrinho.</p>
    </div>
</div>

<script>
(function () {
    'use strict';

    const formulario = document.getElementById('vpFormularioCompra');
    const botaoAdicionar = document.getElementById('vpAdicionarCarrinho');
    const botaoComprar = document.getElementById('vpComprarAgora');
    const campoQuantidade = document.getElementById('vpQuantidade');

    const toast = document.getElementById('vpToast');
    const toastTitulo = document.getElementById('vpToastTitulo');
    const toastTexto = document.getElementById('vpToastTexto');
    const toastIcone = document.getElementById('vpToastIcon');

    let temporizadorToast = null;

    function mostrarMensagem(titulo, mensagem, erro) {
        if (!toast || !toastTitulo || !toastTexto || !toastIcone) {
            window.alert(titulo + '\n' + mensagem);
            return;
        }

        toastTitulo.textContent = titulo;
        toastTexto.textContent = mensagem;
        toast.classList.toggle('error', Boolean(erro));
        toastIcone.className = erro ? 'bi bi-exclamation-circle' : 'bi bi-check-lg';
        toast.classList.add('visible');

        window.clearTimeout(temporizadorToast);
        temporizadorToast = window.setTimeout(function () {
            toast.classList.remove('visible');
        }, 3500);
    }

    function validarQuantidade() {
        if (!campoQuantidade) return false;

        const quantidade = Number(campoQuantidade.value);
        const minimo = Number(campoQuantidade.min || 1);
        const maximo = Number(campoQuantidade.max || 99);

        if (!Number.isInteger(quantidade) || quantidade < minimo || quantidade > maximo) {
            mostrarMensagem(
                'Quantidade inválida',
                'Informe uma quantidade válida para este produto.',
                true
            );
            campoQuantidade.focus();
            return false;
        }

        return true;
    }

    function atualizarContadorCarrinho(total) {
        if (total == null) return;

        const seletores = [
            '#contadorCarrinho',
            '#cart-count',
            '.contador-carrinho',
            '.cart-count',
            '[data-cart-count]'
        ];

        document.querySelectorAll(seletores.join(',')).forEach(function (elemento) {
            elemento.textContent = String(total);
            elemento.setAttribute('aria-label', total + ' itens no carrinho');
        });
    }

    async function adicionarAoCarrinho(comprarAgora) {
        if (!formulario || !validarQuantidade()) return;

        const botao = comprarAgora ? botaoComprar : botaoAdicionar;
        if (!botao) return;

        const textoOriginal = botao.innerHTML;
        botao.disabled = true;
        botao.innerHTML = '<i class="bi bi-hourglass-split"></i> Processando...';

        try {
            const corpo = new URLSearchParams(new FormData(formulario));

            const resposta = await fetch(formulario.action, {
                method: 'POST',
                body: corpo,
                credentials: 'same-origin',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json',
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                }
            });

            if (resposta.redirected) {
                window.location.href = resposta.url;
                return;
            }

            const tipoConteudo = resposta.headers.get('content-type') || '';

            if (!tipoConteudo.includes('application/json')) {
                throw new Error(
                    'O servidor não retornou uma confirmação válida. Verifique o controller do carrinho.'
                );
            }

            const dados = await resposta.json();

            if (resposta.status === 401 && dados.loginUrl) {
                window.location.href = dados.loginUrl;
                return;
            }

            if (!resposta.ok || dados.success !== true) {
                throw new Error(
                    dados.erro ||
                    dados.mensagem ||
                    'Não foi possível adicionar o produto ao carrinho.'
                );
            }

            if (comprarAgora) {
                window.location.href = dados.redirectUrl || '/carrinho';
                return;
            }

            mostrarMensagem(
                'Produto adicionado!',
                dados.mensagem || 'O produto foi adicionado ao carrinho.',
                false
            );

            const totalItens = dados.totalItens != null
                ? dados.totalItens
                : dados.quantidadeCarrinho != null
                    ? dados.quantidadeCarrinho
                    : dados.contador;

            atualizarContadorCarrinho(totalItens);

            document.dispatchEvent(new CustomEvent('carrinho:atualizado', {
                detail: dados
            }));

        } catch (erro) {
            console.error('Erro ao adicionar produto:', erro);
            mostrarMensagem(
                'Não foi possível adicionar',
                erro.message || 'Ocorreu um erro. Tente novamente.',
                true
            );
        } finally {
            botao.disabled = false;
            botao.innerHTML = textoOriginal;
        }
    }

    if (formulario) {
        formulario.addEventListener('submit', function (evento) {
            evento.preventDefault();
            adicionarAoCarrinho(false);
        });
    }

    if (botaoComprar) {
        botaoComprar.addEventListener('click', function () {
            adicionarAoCarrinho(true);
        });
    }
})();
</script>
