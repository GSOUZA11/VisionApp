<div class="titulo-contato">

    <h1>Fale Conosco</h1>

    <p>
        Estamos aqui para ajudar! Entre em contato conosco.
    </p>

</div>

<div class="secao-contato">

    <div class="form-container">

        <h2>Envie sua Mensagem</h2>

        <form>

            <div class="form-group">

                <label>Nome</label>

                <input
                    type="text"
                    placeholder="Seu nome">

            </div>

            <div class="form-group">

                <label>E-mail</label>

                <input
                    type="email"
                    placeholder="seu@email.com">

            </div>

            <div class="form-group">

                <label>Assunto</label>

                <select>

                    <option>Selecione</option>
                    <option>Dúvida</option>
                    <option>Sugestão</option>
                    <option>Reclamação</option>
                    <option>Informações sobre pedido</option>
                    <option>Outro</option>

                </select>

            </div>

            <div class="form-group">

                <label>Mensagem</label>

                <textarea
                    placeholder="Escreva sua mensagem..."></textarea>

            </div>

            <button
                type="submit"
                class="btn-enviar">

                Enviar Mensagem

            </button>

        </form>

    </div>

    <div class="mapa-container">

        <div class="mapa-local">

            <iframe
                src="https://maps.google.com/maps?q=Osasco&t=&z=13&ie=UTF8&iwloc=&output=embed">
            </iframe>

        </div>

    </div>

</div>

<div class="info-contato">

    <h2>Nossas Informações</h2>

    <div class="contatos-grid">

        <div class="contato-card">

            <i class="fas fa-map-marker-alt"></i>

            <h3>Endereço</h3>

            <p>
                Rua Dante Batiston, 248<br>
                Centro, Osasco - SP
            </p>

        </div>

        <div class="contato-card">

            <i class="fas fa-phone-alt"></i>

            <h3>Telefone</h3>

            <p>(11) 99999-9999</p>

        </div>

        <div class="contato-card">

            <i class="fas fa-envelope"></i>

            <h3>E-mail</h3>

            <p>visionstore@gmail.com</p>

        </div>

        <div class="contato-card">

            <i class="fas fa-clock"></i>

            <h3>Horário</h3>

            <p>
                Seg a Sex: 9h às 18h<br>
                Sábado: 9h às 13h
            </p>

        </div>

    </div>

</div>

