<main class="admin-oculos-main">
    <section class="admin-card">
        <div class="admin-header">
            <h1>Cadastrar Novo Óculos</h1>
            <p>Preencha as informações do produto para exibir no catálogo.</p>
        </div>

        <form action="/oculos/novo" method="POST" enctype="multipart/form-data" class="admin-form">
            <div class="form-grid">
                <div class="form-group full">
                    <label>Nome do produto *</label>
                    <input type="text" name="nome" required placeholder="Ex: Eclipse Ruby">
                </div>

                <div class="form-group full">
                    <label>Descrição</label>
                    <textarea name="descricao" id="descricao" maxlength="500" placeholder="Descreva o modelo, estilo, lente e diferenciais..."></textarea>
                    <small><span id="contador">0</span>/500 caracteres</small>
                </div>

                <div class="form-group">
                    <label>Categoria *</label>
                    <select name="categoria" required>
                        <option value="">Selecione</option>
                        <option value="Grau">Grau</option>
                        <option value="Sol">Sol</option>
                        <option value="Esportivo">Esportivo</option>
                        <option value="Classico">Clássico</option>
                        <option value="Vintage">Vintage</option>
                        <option value="Fashion">Fashion</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Cor</label>
                    <select name="cor">
                        <option value="">Selecione</option>
                        <option value="Preto">Preto</option>
                        <option value="Marrom">Marrom</option>
                        <option value="Cinza">Cinza</option>
                        <option value="Azul">Azul</option>
                        <option value="Rosa">Rosa</option>
                        <option value="Espelhado">Espelhado</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Tamanho</label>
                    <select name="tamanho">
                        <option value="">Selecione</option>
                        <option value="P">P</option>
                        <option value="M">M</option>
                        <option value="G">G</option>
                        <option value="Único">Único</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Preço *</label>
                    <input type="number" name="preco" step="0.01" min="0" required placeholder="299.90">
                </div>

                <div class="form-group">
                    <label>Estoque</label>
                    <input type="number" name="estoque" min="0" value="0">
                </div>

                <div class="form-group full">
                    <label>Imagem do produto</label>
                    <input type="file" name="imagem" id="imagem" accept="image/*">
                </div>

                <div class="preview-box full">
                    <p>Prévia da imagem</p>
                    <img id="preview" src="" alt="Prévia do produto">
                </div>
            </div>

            <div class="form-actions">
                <a href="/oculos/completo" class="btn-voltar">Cancelar</a>
                <button type="submit" class="btn-cadastrar">Cadastrar Produto</button>
            </div>
        </form>
    </section>
</main>

<style>
    .admin-oculos-main {
        padding: 40px 20px;
        display: flex;
        justify-content: center;
    }

    .admin-card {
        width: 100%;
        max-width: 980px;
        background: var(--branco);
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,.12);
        padding: 35px;
    }

    .admin-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .admin-header h1 {
        font-size: 34px;
        font-weight: bold;
        color: #2f2416;
        margin-bottom: 8px;
    }

    .admin-header p {
        color: #666;
        margin: 0;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-group.full,
    .preview-box.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        font-weight: 600;
        margin-bottom: 8px;
        color: #2f2416;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 15px;
        outline: none;
        background: #fff;
    }

    .form-group textarea {
        min-height: 120px;
        resize: vertical;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: var(--comp);
        box-shadow: 0 0 0 3px rgba(65,105,225,.12);
    }

    .form-group small {
        color: #777;
        margin-top: 6px;
        text-align: right;
    }

    .preview-box {
        background: #f5f5f5;
        border: 1px dashed #ccc;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
    }

    .preview-box p {
        font-weight: 600;
        color: #4e4a42;
        margin-bottom: 15px;
    }

    .preview-box img {
        display: none;
        max-width: 240px;
        max-height: 180px;
        object-fit: contain;
        margin: 0 auto;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 30px;
    }

    .btn-voltar,
    .btn-cadastrar {
        border: none;
        border-radius: 8px;
        padding: 12px 22px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-voltar {
        background: #eee;
        color: #333;
    }

    .btn-cadastrar {
        background: var(--comp);
        color: var(--branco);
    }

    .btn-cadastrar:hover {
        background: #2c5aa0;
    }

    @media (max-width: 700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .admin-card {
            padding: 25px;
        }

        .admin-header h1 {
            font-size: 28px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-voltar,
        .btn-cadastrar {
            width: 100%;
            text-align: center;
        }
    }
</style>

<script>
    const descricao = document.getElementById('descricao');
    const contador = document.getElementById('contador');
    const imagem = document.getElementById('imagem');
    const preview = document.getElementById('preview');

    if (descricao && contador) {
        descricao.addEventListener('input', () => {
            contador.textContent = descricao.value.length;
        });
    }

    if (imagem && preview) {
        imagem.addEventListener('change', () => {
            const arquivo = imagem.files[0];

            if (!arquivo) {
                preview.style.display = 'none';
                preview.src = '';
                return;
            }

            preview.src = URL.createObjectURL(arquivo);
            preview.style.display = 'block';
        });
    }
</script>