                <!-- Suporte -->
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-start gap-3">
                                

                                <div class="flex-grow-1">
                                    <h3 class="h6 fw-bold">
                                        Precisa de ajuda?
                                    </h3>

                                    <p class="text-muted mb-3">
                                        Entre em contato com a Vision
                                        se tiver dúvidas.
