<div class="container py-5">

    <!-- Cabeçalho -->
    <div class="mb-4">
        <p class="text-muted small text-uppercase fw-semibold mb-2">
            ÁREA DO CLIENTE
        </p>

        <h1 class="h2 fw-bold mb-2">Minha conta</h1>

        <p class="text-muted mb-0">
            Olá, <%= usuario.nome || 'Cliente' %>!
