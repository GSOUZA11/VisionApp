
<div class="container py-5">

    <!-- Cabeçalho -->
    <div class="mb-4">
        <h1 class="h3 mb-2">Editar meus dados</h1>
        <p class="text-muted mb-0">
            Atualize suas informações pessoais na Vision.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">

                    <!-- Identificação -->
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div
                            class="rounded-circle bg-light d-flex align-items-center justify-content-center flex-shrink-0"
                            style="width: 60px; height: 60px;"
                        >
                            <i class="bi bi-person-gear fs-2"></i>
                        </div>

                        <div>
                            <h2 class="h5 mb-1">Seus dados pessoais</h2>
                            <p class="text-muted mb-0">
                                Confira e altere suas informações.
                            </p>
                        </div>
                    </div>

                    <hr class="mb-4">

                    <!-- Formulário -->
                    <form action="/clientes/editar" method="POST">

                        <!-- Nome -->
                        <div class="mb-4">
                            <label for="nome" class="form-label fw-semibold">
                                Nome completo
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="nome"
                                    name="nome"
                                    value="<%= usuario.nome || '' %>"
                                    placeholder="Digite seu nome completo"
                                    maxlength="150"
                                    autocomplete="name"
                                    required
                                >
                            </div>
                        </div>

                        <!-- E-mail -->
                        <div class="mb-4">
                            <label for="email" class="form-label fw-semibold">
                                E-mail
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-envelope"></i>
                                </span>

                                <input
                                    type="email"
                                    class="form-control"
                                    id="email"
                                    name="email"
                                    value="<%= usuario.email || '' %>"
                                    placeholder="Digite seu e-mail"
                                    maxlength="255"
                                    autocomplete="email"
                                    required
                                >
                            </div>
                        </div>

                        <!-- Telefone -->
                        <div class="mb-4">
                            <label for="telefone" class="form-label fw-semibold">
                                Telefone
                            </label>

                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-telephone"></i>
                                </span>

                                <input
                                    type="tel"
                                    class="form-control"
                                    id="telefone"
                                    name="telefone"
                                    value="<%= usuario.telefone || '' %>"
                                    placeholder="Digite seu telefone"
                                    maxlength="20"
                                    autocomplete="tel"
                                >
                            </div>

                            <div class="form-text">
                                Informe um telefone para contato, se desejar.
                            </div>
                        </div>

                        <hr class="my-4">

                        <!-- Botões -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit" class="btn btn-dark">
                                <i class="bi bi-check-lg me-2"></i>
                                Salvar alterações
                            </button>

                            <a
                                href="/clientes"
                                class="btn btn-outline-dark"
                            >
                                <i class="bi bi-arrow-left me-2"></i>
                                Voltar para minha conta
                            </a>

                        </div>

                    </form>

                </div>
            </div>

            <!-- Aviso -->
            <p class="text-muted small mt-3 mb-0">
                <i class="bi bi-shield-check me-1"></i>
                Mantenha seus dados atualizados para facilitar suas compras.
            </p>

        </div>
    </div>

</div>
